# Created Well local development environment
# Copy to .env.local. Never commit .env.local or paste values into source control.

# Browser-visible configuration. These are not a secret boundary.
VITE_DEV_BYPASS=false
# VITE_API_BASE=http://localhost:3000/api/server
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
VITE_APP_PASSWORD_HASH=your_client_visible_password_hash_here
VITE_GCAL_CLIENT_ID=your_google_oauth_client_id_here

# Server-only values. Store real values in Vercel/secret-manager settings.
NOTION_SECRET=secret_your_notion_token_here
NOTION_DB_MOVES=your_moves_database_id
NOTION_DB_PEOPLE=your_people_database_id
NOTION_DB_FLOWS=your_flows_database_id
NOTION_DB_CONTENT=your_content_database_id
NOTION_DB_MONEY=your_money_database_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CR8W_PASSWORD=your_server_password_here

# Optional Google Calendar sync
# CR8W_ICAL_URL=https://calendar.google.com/calendar/ical/your-calendar/basic.ics
# GCAL_CREATEWELL_ICS_URL=https://calendar.google.com/calendar/ical/your-calendar/basic.ics
# GCAL_CLIENT_SECRET=your_google_client_secret_here
