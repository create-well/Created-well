# ── Developer local config ───────────────────────────────────────────────
# Copy this file to .env.local and adjust values.
# .env.local is gitignored — never commit real credentials.

# Dev auth bypass — skips the Supabase login screen entirely.
# Set to 'true' to sign in as the default profile (monny).
# Or set to any profile key to sign in as that person:
#   sunshine | monny | bingle | omar | pia | event-support
VITE_DEV_BYPASS=true

# Supabase project (public, safe to commit — already in AuthGate.tsx)
# VITE_SUPABASE_URL=https://irtqcygriedvdijppntz.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key — see AuthGate.tsx>

# Optional: override the server API base for local Edge Function testing
# VITE_API_BASE=http://localhost:54321/functions/v1/make-server-dabe1c74
